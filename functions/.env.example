# Copy to .env and fill in. Firebase loads functions/.env on deploy and in the emulator.
MASSIVE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 format, e.g. +15125550100
TWILIO_FROM_NUMBER=
ALERT_TO_NUMBER=

# ---- Schwab (developer.schwab.com) ----
# App Key and Secret from your app's page once its status is "Ready For Use".
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must match the Callback URL registered on the Schwab app exactly.
SCHWAB_CALLBACK_URL=https://us-central1-money-maker-ronnie.cloudfunctions.net/schwabAuth
# A long random secret; your connect link is SCHWAB_CALLBACK_URL?connect=<this>. Generate with: openssl rand -hex 24
SCHWAB_CONNECT_KEY=
# Your individual brokerage account number (only needed if more than one account is linked).
SCHWAB_ACCOUNT_NUMBER=
# off = text signals only (default). live = place the orders and text what filled.
SCHWAB_TRADING=off
# Optional: never place a single order costing more than this many dollars.
SCHWAB_MAX_ORDER_COST=

# Bx-Trender put/call seller (functions/src/bx.ts). Its own Schwab account: on the next Schwab
# reconnect, tick BOTH accounts. Must differ from SCHWAB_ACCOUNT_NUMBER.
BX_SCHWAB_ACCOUNT_NUMBER=
# Set to live to let the app's Open / Close buttons place orders. Anything else: texts only.
BX_TRADING=off
# Optional: refuse any single open needing more margin than this, in dollars.
BX_MAX_ORDER_MARGIN=
